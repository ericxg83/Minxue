# 生产环境变量模板（复制为 .env.production 后填真实值，.env.production 已被 .gitignore 忽略）
# 注意：数据库/Redis 的连接串由 docker-compose.yml 的 environment 强制覆盖，
# 这里不用填 db/redis（容器内部用主机名 db / redis）。

NODE_ENV=production
PORT=3001

# ------------------ 对象存储（沿用现有阿里云 OSS 上海，凭证不变）------------------
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=your-oss-bucket
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_CDN_DOMAIN=https://your-bucket.oss-cn-shanghai.aliyuncs.com

# ------------------ AI（沿用现有国内直连供应商，不改）------------------
AI_API_KEY=your-modelscope-key
AI_ENDPOINT=https://api-inference.modelscope.cn/v1/chat/completions
AI_MODEL=Qwen/Qwen3.5-122B-A10B
# 备用 Key 按需追加（智谱 / 商汤 / 魔搭第二把 Key 等），与现有 render.yaml 一致
# SENSENOVA_API_KEY=
# BIGMODEL_API_KEY=
# MODELSCOPE_BACKUP_API_KEY=

# ------------------ 任务队列（Redis 已在 compose 内，这里只留调优）------------------
MAX_RETRIES=3
TASK_LOCK_DURATION_MS=300000
CONCURRENCY=2

# ------------------ CORS：填你的前端域名（重要，否则浏览器拦接口）------------------
ALLOWED_ORIGIN=https://your-domain.example.cn
