# ============================================
# 敏学App V3 前端开发环境配置
# 本地开发时使用 (npm run dev)
# ============================================

# ------------------ API 配置 ------------------
# 后端 API 地址（开发环境通过 Vite 代理，留空即可）
VITE_API_URL=

# ------------------ OSS CDN 配置 ------------------
# 阿里 OSS CDN 域名（用于图片加速）
VITE_OSS_CDN_DOMAIN=https://cdn.yourdomain.com

# ------------------ AI 服务配置 ------------------

# ------------------ 应用环境标识 ------------------
VITE_APP_ENV=development
