# ============================================
# 敏学App V3 环境变量配置 (示例)
# ============================================

# ------------------ 数据库配置 ------------------
# Neon PostgreSQL (主要数据库)
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-late-sun-aosak7tj-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ------------------ 对象存储配置 ------------------
# 阿里 OSS
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=your-oss-bucket
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_CDN_DOMAIN=https://your-bucket.oss-cn-shanghai.aliyuncs.com

# ------------------ AI 服务配置 ------------------
AI_API_KEY=your-ai-api-key
AI_ENDPOINT=https://api-inference.modelscope.cn/v1/chat/completions
AI_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 备用2 API（魔搭 ModelScope 第二把 Key，同一端点独立免费额度；可选）
# MODELSCOPE_BACKUP_API_KEY=your-second-modelscope-key
# MODELSCOPE_BACKUP_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Agnes 备用 API（独立配额，与魔搭解耦；可选）
# AGENS_API_KEY=your-agnes-api-key

# FreeModel 备用 API（5 小时配额重置，仅作最后兜底；可选）
# FREEMODEL_API_KEY=fe_oa_your_freemodel_key

# SenseNova 备用 API（商汤日日新，公测期免费 1500 次/5 小时；可选）
# SENSENOVA_API_KEY=sk-your-sensenova-key

# GMI Cloud (https://api.gmi-serving.com/v1)：OpenAI 兼容，独立于魔搭的供应商。
# 2026-09 用户场景："免费 10 天 Key"，用 GMI_FIRST=1 可在 10 天内顶替魔搭作为主 KEY，
# 避免魔搭限流/配额耗尽。Key 失效后改 0 即可回落。
# - GMI_API_KEY：你的 gmi-serving.com 控制台拿的 API Key
# - GMI_FIRST=1：开启"主 KEY"模式（GMI 顶到魔搭前面；视觉链 + 文本链都生效）
# - GMI_BASE_URL：可选，默认 https://api.gmi-serving.com/v1
# - GMI_VL_MODELS：可选，逗号分隔的视觉模型 ID（按顺序尝试，失败回退下一个）
#   默认 ['Qwen/Qwen3-VL-235B-A22B-Instruct', 'Qwen/Qwen3-VL-8B-Instruct']，实测后请改成 gmi 真实支持的模型名
# - GMI_TEXT_MODEL：可选，文本模型 ID，默认 'Qwen/Qwen3-8B-Instruct'（gmi 端点若不支持请调整）
# GMI_API_KEY=gmi_your_key_here
# GMI_FIRST=1
# GMI_VL_MODELS=Qwen/Qwen3-VL-235B-A22B-Instruct,Qwen/Qwen3-VL-8B-Instruct
# GMI_TEXT_MODEL=Qwen/Qwen3-8B-Instruct

# ------------------ 两段式批改：答案引擎 + OCR 模式（2026-09-04 新增）------------------
# 【为什么拆开】视觉模型（MiniMax / SenseNova 6.8）能看懂卷面但算题弱；
# 12 道复杂数学题实测（deliverables/complex_model_benchmark_report_20260904.md）：
#   DeepSeek V4 Pro 12/12 · GLM-5.2 9/12 · SenseNova 6.8 7/12（DeepSeek 同时 token 最省）
# 而 DeepSeek V4 Pro 明确不支持图片输入（400 Model do not support image input）。
# 所以：视觉模型只负责 OCR，标准答案/解析交给答案引擎。
#
# - ANSWER_ENGINE_ENABLED：默认 1。设 0 = 一键回滚到改造前的通用文本链路。
# - ANSWER_ENGINE_VENDOR：默认 SenseNova（BACKUP_VENDOR_DEFS 里的供应商名）
# - ANSWER_ENGINE_MODEL：默认 deepseek-v4-pro
# - ANSWER_ENGINE_FALLBACK_MODELS：逗号分隔，主模型失败时按序降级，默认 glm-5.2,sensenova-6.8-flash-lite
# - ANSWER_ENGINE_TIMEOUT_MS：默认 60000
# - ANSWER_ENGINE_KEYS：逗号分隔的额外 Key（多个免费账号），与供应商主 Key 合并成 Key 池。
#   SenseNova 公测额度是「账号 × 5 小时」重置，玩法就是多开几个免费账号把配额叠起来。
#   N 把 Key = N 倍额度；某 Key 5h 额度用尽会自动进入冷却并换下一把，重置后自动复用（无需重启）。
# - ANSWER_ENGINE_KEY_COOLDOWN_MS：Key 冷却时长（毫秒），默认 5h（对齐 SenseNova 重置节奏）。
# ANSWER_ENGINE_ENABLED=1
# ANSWER_ENGINE_VENDOR=SenseNova
# ANSWER_ENGINE_MODEL=deepseek-v4-pro
# ANSWER_ENGINE_FALLBACK_MODELS=glm-5.2,sensenova-6.8-flash-lite
# ANSWER_ENGINE_TIMEOUT_MS=60000
# ANSWER_ENGINE_KEYS=sk-sensenova-key-2,sk-sensenova-key-3
# ANSWER_ENGINE_KEY_COOLDOWN_MS=18000000
#
# - OCR_ANSWER_MODE：控制视觉模型要不要自己算答案
#   copy_only（默认）：只照抄卷面【印刷体】答案栏/参考答案，没有就填 null，不自行解题。
#                     省 token，且不再让计算弱的视觉模型产出错误答案；留空由答案引擎在 Step 7 统一重解。
#   legacy          ：回滚到旧行为（视觉模型独立解出标准答案）。
# OCR_ANSWER_MODE=copy_only

# ------------------ Redis 配置 ------------------
# 本地 Redis（开发用，设置为 true 启用）
REDIS_LOCAL=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_LOCAL_PASSWORD=

# Upstash（云端 Redis，免费额度 50 万次/月）
#
# ⭐ 双账户自动故障转移 + 配额熔断机制：
# 1) REDIS_URL 是主用实例
# 2) REDIS_POOL_URLS 是备用实例池（逗号分隔，按顺序尝试）
# 3) 当主实例返回 `ERR max requests limit exceeded` 时，redisManager 会
#    自动标记主实例为「额度熔断」、断开连接、关闭 BullMQ Worker，
#    并用下一个可用实例重建队列（见 server/redisManager.js + queue.js）
# 4) 每个月的 1 号 00:01（本地时区）会自动解除所有熔断标记，
#    重新把主实例拉回候选池（与 Upstash 免费额度「每月重置」对齐）
#
# ⭐ URL 拼接：Upstash 控制台 → Redis → Details → 拿 "Endpoint" 和 "Redis password"
#    rediss://default:<Redis password>@<Endpoint>:6379
#
# 当前主用：
REDIS_URL=rediss://default:your-password@your-redis-host.upstash.io:6379

# 备用池（旧的 quota 已满账户可放进来当 backup，次月 1 号自动恢复）
REDIS_POOL_URLS=rediss://default:pass-old@old-host.upstash.io:6379

# 调优：降低 Redis 请求量（空闲 Worker 轮询间隔，秒；默认 60）
# REDIS_DRAIN_DELAY=60
# REDIS_STALLED_INTERVAL=300000

# ------------------ 服务器配置 ------------------
PORT=3001
NODE_ENV=development

# ------------------ 任务队列配置 ------------------
MAX_RETRIES=3
TASK_TIMEOUT_MS=1800000
CONCURRENCY=2

# ------------------ Render API（拉取生产日志用，本地开发可留空）------------------
# API Key:   https://dashboard.render.com/account/api-keys
# Owner ID:  https://dashboard.render.com/settings (workspace 名称下方)
# Service ID: service 页面 URL 中 srv-xxxxxxxx 部分
# RENDER_API_KEY=rnd_xxxxxxxxxxxx
# RENDER_OWNER_ID=tea-xxxxxxxxxxxx
# RENDER_SERVICE_ID=srv-xxxxxxxxxxxx
